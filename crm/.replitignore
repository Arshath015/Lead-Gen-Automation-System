# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Git history and LFS objects are not needed by the running application.
.git

# Workspace backups and source archives are not runtime assets. Keeping these
# out of the deployment image prevents multi-gigabyte layer uploads.
/PipelineOS.zip
/db_backup.zip
/pipelineos_backup.dump
/project.zip
/stampsize-crm.zip
/stampsize-crm-20260822.zip
/stampsize-crm-backup-20260901-0600.zip
/zidSj2eB
